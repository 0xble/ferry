#!/usr/bin/env bash
# Repository CI contract.
#
#   ./bin/ci preflight                 fast, offline, bypassable developer feedback
#   ./bin/ci gate <exact-HEAD-SHA>     merge requirement, run by the GitHub gate
#   ./bin/ci nightly <exact-HEAD-SHA>  gate plus broad validation, run on schedule
#
# Stages run in a fixed order so the first failure is the one worth fixing.

set -euo pipefail

usage() {
  printf 'Usage: ./bin/ci preflight | gate <exact-HEAD-SHA> | nightly <exact-HEAD-SHA>\n' >&2
  exit 64
}

profile="${1:-}"
case "$profile" in
  preflight) [[ $# -eq 1 ]] || usage ;;
  gate|nightly) [[ $# -eq 2 && "$2" =~ ^[0-9a-f]{40}$ ]] || usage ;;
  *) usage ;;
esac

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
cd "$root"

if ! command -v go >/dev/null 2>&1; then
  echo "env_missing: go toolchain not found on PATH" >&2
  exit 127
fi

run() {
  local stage=$1
  shift
  printf '>> %s\n' "$stage"
  "$@"
}

check_format() {
  local unformatted
  unformatted=$(git ls-files -z -- '*.go' | xargs -0 gofmt -l)
  if [[ -n "$unformatted" ]]; then
    printf 'gofmt would reformat:\n%s\n' "$unformatted" >&2
    return 1
  fi
}

if [[ "$profile" == preflight ]]; then
  # Works on a dirty developer checkout. No tests, no network beyond the module cache.
  run whitespace git diff --check
  run whitespace-staged git diff --cached --check
  run format check_format
  run vet go vet ./...
  run build go build ./...
  printf 'PASS: preflight at %s\n' "$(git rev-parse HEAD)"
  exit 0
fi

expected=$2
write_local_receipt() {
  local remote path owner repo branch state_root receipt tmp
  remote=$(git remote get-url origin 2>/dev/null) || {
    echo 'cannot write local gate receipt: origin remote is unavailable' >&2
    return 1
  }
  remote=${remote%/}
  remote=${remote%.git}
  case "$remote" in
    *://*) path=${remote#*://}; path=${path#*/} ;;
    *:*) path=${remote##*:} ;;
    *) path=$remote ;;
  esac
  repo=${path##*/}
  owner=${path%/*}
  owner=$(printf '%s' "$owner" | tr '[:upper:]' '[:lower:]')
  repo=$(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]')
  if [[ ! "$owner" =~ ^[a-z0-9][a-z0-9._-]*$ || ! "$repo" =~ ^[a-z0-9][a-z0-9._-]*$ ]]; then
    echo "cannot write local gate receipt: unsupported origin URL $remote" >&2
    return 1
  fi
  branch=$(git branch --show-current)
  branch=${branch//\\/\\\\}
  branch=${branch//\"/\\\"}
  state_root="${CI_RECEIPT_ROOT:-${XDG_STATE_HOME:-$HOME/.local/state}/ci-receipts}"
  receipt="$state_root/$owner/$repo/$expected.json"
  tmp="$receipt.tmp.$$"
  mkdir -p "$(dirname "$receipt")"
  (
    umask 077
    printf '{\n  "schema_version": 1,\n  "repository": "%s/%s",\n  "sha": "%s",\n  "branch": "%s",\n  "command": "./bin/ci gate",\n  "gate_exit": 0,\n  "clean_tracked_tree": true,\n  "timestamp": "%s"\n}\n' \
      "$owner" "$repo" "$expected" "$branch" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$tmp"
  )
  mv -f -- "$tmp" "$receipt"
  printf 'local gate receipt: %s\n' "$receipt"
}

assert_candidate() {
  local actual
  actual=$(git rev-parse HEAD)
  if [[ "$actual" != "$expected" ]]; then
    printf 'ERROR: HEAD mismatch: expected %s, got %s\n' "$expected" "$actual" >&2
    exit 1
  fi
  if ! git diff --quiet --ignore-submodules=none || ! git diff --cached --quiet --ignore-submodules=none; then
    printf 'ERROR: tracked candidate tree is dirty at %s\n' "$expected" >&2
    exit 1
  fi
}

assert_candidate
export CI=true
run format check_format
run vet go vet ./...
run test go test ./...
run build go build ./...
run race go test -race ./...

if [[ "$profile" == nightly ]]; then
  run race-uncached-shuffled go test -race -count=1 -shuffle=on ./...
  # Cross-compile every target the release configuration ships.
  for target in darwin/amd64 darwin/arm64 linux/amd64 linux/arm64; do
    for cmd in ferry ferryd; do
      run "cross-build $cmd $target" env CGO_ENABLED=0 GOOS="${target%/*}" GOARCH="${target#*/}" \
        go build -o /dev/null "./cmd/$cmd"
    done
  done
fi

assert_candidate
if [[ "$profile" == gate && "${GITHUB_ACTIONS:-}" != true ]]; then
  # Local exact-SHA evidence for tooling that marks PRs ready. Hosted CI stays authoritative.
  write_local_receipt
fi
printf 'PASS: %s validated %s and unchanged tracked tree\n' "$profile" "$expected"
