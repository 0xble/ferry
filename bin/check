#!/usr/bin/env bash
# GENERATED by tools templates v1. Edit templates/ and run bin/update-policy.
# Repository-native check: format, vet, lint, race tests, build, scripts.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

for tool in go gofmt golangci-lint shellcheck; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    printf 'error: required check tool is unavailable: %s\n' "$tool" >&2
    exit 1
  fi
done

fail=0
unformatted="$(gofmt -l .)"
if [ -n "$unformatted" ]; then
  printf 'gofmt needed:\n%s\n' "$unformatted" >&2
  fail=1
fi

GOWORK=off go vet ./... || fail=1
GOWORK=off golangci-lint run ./... || fail=1
GOWORK=off go test -race -count=1 ./... || fail=1
GOWORK=off go build ./... || fail=1
shellcheck bin/check bin/setup || fail=1

if [ -x bin/check-extra ]; then
  GOWORK=off ./bin/check-extra || fail=1
fi

if [ "$fail" -eq 0 ]; then
  echo "check passed"
else
  echo "check FAILED" >&2
  exit 1
fi
